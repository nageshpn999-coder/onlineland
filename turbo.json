{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["FIREBASE_WEBAPP_CONFIG", "FIREBASE_CONFIG", "GOOGLE_CLOUD_PROJECT", "NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "lib/**"]
    }
  }
}
