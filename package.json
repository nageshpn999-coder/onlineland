{
  "name": "onlineland-platform",
  "version": "0.1.0",
  "private": true,
  "description": "OnlineLand — Find Your Perfect Property. Website, Android app and admin dashboard on one Firebase backend.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @onlineland/web",
    "build:web": "npm run build -w @onlineland/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-onlineland",
    "emulators:check": "firebase emulators:exec --config firebase/firebase.json --project demo-onlineland --only auth,firestore,storage \"node scripts/check-emulators.mjs\"",
    "deploy:rules:dev": "firebase deploy --config firebase/firebase.json --project dev --only firestore:rules,firestore:indexes,storage",
    "deploy:rules:prod": "firebase deploy --config firebase/firebase.json --project prod --only firestore:rules,firestore:indexes,storage"
  },
  "devDependencies": {
    "firebase-tools": "^15.35.0",
    "typescript": "~6.0.3"
  }
}
